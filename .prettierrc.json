{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-sql", "prettier-plugin-toml"],
  "overrides": [
    {
      "files": "**/*.sql",
      "options": {
        "language": "postgresql"
      }
    }
  ]
}
