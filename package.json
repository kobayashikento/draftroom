{
  "name": "draftroom",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm typecheck && next build --webpack",
    "start": "node scripts/serve.ts",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "pnpm typecheck",
    "typecheck": "next typegen && tsc --noEmit && tsc --project tsconfig.edge.json --noEmit",
    "typecheck:edge": "tsc --project tsconfig.edge.json --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@dnd-kit/collision": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@emotion/react": "11.14.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tus-js-client": "^4.3.1"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/deno": "2.7.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-sql": "0.20.0",
    "prettier-plugin-toml": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
